        {
          "name": "1.3 Login Verified Account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response is valid JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status code is 200\", function () {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is under 5 seconds\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has success field set to true\", function () {\r",
                  "    var body = pm.response.json();\r",
                  "    pm.expect(body).to.have.property(\"success\");\r",
                  "    pm.expect(body.success).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has user object with required fields\", function () {\r",
                  "    var body = pm.response.json();\r",
                  "    pm.expect(body).to.have.property(\"data\");\r",
                  "    pm.expect(body.data).to.have.property(\"user\");\r",
                  "    pm.expect(body.data.user).to.have.property(\"id\");\r",
                  "    pm.expect(body.data.user).to.have.property(\"email\");\r",
                  "    pm.expect(body.data.user).to.have.property(\"display_name\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has tokens object with access and refresh\", function () {\r",
                  "    var body = pm.response.json();\r",
                  "    pm.expect(body.data).to.have.property(\"tokens\");\r",
                  "    pm.expect(body.data.tokens).to.have.property(\"access_token\");\r",
                  "    pm.expect(body.data.tokens).to.have.property(\"refresh_token\");\r",
                  "    pm.expect(body.data.tokens.access_token).to.be.a(\"string\");\r",
                  "    pm.expect(body.data.tokens.refresh_token).to.be.a(\"string\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Access token starts with eyJ (valid JWT format)\", function () {\r",
                  "    var token = pm.response.json().data.tokens.access_token;\r",
                  "    pm.expect(token.substring(0, 3)).to.eql(\"eyJ\");\r",
                  "});\r",
                  "\r",
                  "// Save tokens for all subsequent requests\r",
                  "if (pm.response.code === 200) {\r",
                  "    var tokens = pm.response.json().data.tokens;\r",
                  "    pm.collectionVariables.set(\"auth_token\", tokens.access_token);\r",
                  "    pm.collectionVariables.set(\"refresh_token\", tokens.refresh_token);\r",
                  "    console.log(\"Auth token saved: \" + tokens.access_token.substring(0, 20) + \"...\");\r",
                  "    console.log(\"Refresh token saved\");\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
