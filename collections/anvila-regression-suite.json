      "name": "Flow 1 — Auth Chain",
      "item": [
        {
          "name": "Request 1.1: Register New User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Response is valid JSON\", function () {\r",
                  "    pm.response.to.be.json;\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status code is 201 Created\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response time is under 5 seconds\", function () {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(5000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has success field\", function () {\r",
                  "    var body = pm.response.json();\r",
                  "    pm.expect(body).to.have.property(\"success\");\r",
                  "    pm.expect(body.success).to.eql(true);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response has user data with id and email\", function () {\r",
                  "    var body = pm.response.json();\r",
                  "    pm.expect(body).to.have.property(\"data\");\r",
                  "    pm.expect(body.data).to.have.property(\"id\");\r",
                  "    pm.expect(body.data).to.have.property(\"email\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Account is unverified by default\", function () {\r",
                  "    var body = pm.response.json();\r",
                  "    pm.expect(body.data.email_verified).to.eql(false);\r",
                  "});\r",
                  "\r",
                  "// Save registered email for next requests\r",
                  "if (pm.response.code === 201) {\r",
                  "    var email = pm.response.json().data.email;\r",
                  "    pm.collectionVariables.set(\"registered_email\", email);\r",
                  "    console.log(\"Saved registered email: \" + email);\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
